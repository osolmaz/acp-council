{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/domain/count.ts", "src/domain/vote.ts", "src/domain/council.ts"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
